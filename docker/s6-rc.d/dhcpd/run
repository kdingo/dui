#!/command/with-contenv bash
DATA_DIR="${DUI_DATA_DIR:-/data}"
LOGS_DIR="${DUI_LOGS_DIR:-/var/log/dui}"
mkdir -p "$LOGS_DIR"
touch "$LOGS_DIR/dhcpd.log"
# -d sends dhcpd messages to stderr (no syslog in this image). Persist them for the UI.
# -user/-group: dhcpd binds its sockets as root, then drops to the dhcpd user, which can write
# only the leases directory.
exec dhcpd -user dhcpd -group dhcpd -d -f -cf "$DATA_DIR/dhcpd.conf" -lf "$DATA_DIR/leases/dhcpd.leases" -pf /run/dhcpd/dhcpd.pid "${DUI_INTERFACE:-eth0}" >> "$LOGS_DIR/dhcpd.log" 2>&1
